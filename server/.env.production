# Configuration pour la production
PORT=5001
NODE_ENV=production

# Base de données (à adapter selon votre configuration de production)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=adei_db
DB_USER=adei_user
DB_PASSWORD=adei_password

# JWT Secret (utilisez une clé forte en production)
JWT_SECRET=adei-production-secret-key-2026-secure

# CORS Origins (ajoutez vos domaines de production)
CORS_ORIGINS=https://adei-ensaf.ma,https://www.adei-ensaf.ma